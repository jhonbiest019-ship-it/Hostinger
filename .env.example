# MySQL connection string used only by Prisma/server code.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/outreach_studio"

# Public base URL used for callback links and canonical URLs.
APP_URL="http://localhost:3000"

# 32-byte secret used by the future credential encryption service.
# Generate a strong value; never commit the real key.
ENCRYPTION_KEY="replace-with-a-32-byte-secret"

# Secret used to verify signed authenticated session cookies.
AUTH_SESSION_SECRET="replace-with-a-long-random-session-secret"

# Queue worker controls. The worker never runs from browser JavaScript.
QUEUE_MAX_JOBS_PER_RUN="10"
QUEUE_MAX_ATTEMPTS="3"
QUEUE_DELAY_MS="1500"
QUEUE_LEASE_MS="120000"

# Standalone worker controls. Keep WORKER_SKIP_INBOX_SYNC false outside isolated tests.
WORKER_INTERVAL_MS="60000"
WORKER_RUN_ONCE="false"
WORKER_SKIP_INBOX_SYNC="false"
QUEUE_LEASE_MS="120000"

# Standalone worker controls. WORKER_RUN_ONCE is useful for one-shot scheduler invocations.
WORKER_INTERVAL_MS="60000"
WORKER_RUN_ONCE="false"

# Test-only safety switch. Do not enable in production.
WORKER_SKIP_INBOX_SYNC="false"

# Required by the protected worker HTTP endpoint. Keep this server-only.
WORKER_TOKEN="replace-with-a-long-random-worker-token"

# Set to true only for isolated local tests. It prevents SMTP network access.
EMAIL_TEST_MODE="false"
